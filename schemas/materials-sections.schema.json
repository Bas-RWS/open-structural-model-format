{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Bas-RWS/open-structural-model-format/schemas/materials-sections.schema.json",
  "title": "OSMF Materials and Sections",
  "description": "Material and Section. See specification/materials-sections.md. Geometric checks (polygon orientation, overlaps) and computed properties are handled by validators.",
  "type": "object",
  "properties": {
    "materials": { "type": "array", "items": { "$ref": "#/$defs/Material" } },
    "sections": { "type": "array", "items": { "$ref": "#/$defs/Section" } }
  },
  "additionalProperties": true,
  "$defs": {
    "Positive": { "type": "number", "exclusiveMinimum": 0 },
    "Point2": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "Polygon": { "type": "array", "items": { "$ref": "#/$defs/Point2" }, "minItems": 3 },
    "Provenance": {
      "type": "object",
      "properties": {
        "library": { "type": "string" },
        "version": { "type": "string" },
        "item_id": { "type": "string" }
      },
      "required": ["library", "version", "item_id"],
      "additionalProperties": false
    },
    "Material": {
      "allOf": [{ "$ref": "core.schema.json#/$defs/ObjectBase" }],
      "properties": {
        "id": true, "type": { "const": "Material" }, "number": true, "name": true, "extensions": true,
        "general": {
          "type": "object",
          "properties": {
            "category": { "enum": ["concrete", "steel", "reinforcement", "prestressing_steel", "timber", "aluminium", "masonry", "other"] },
            "grade": { "type": "string" }
          },
          "required": ["category"],
          "additionalProperties": false
        },
        "properties": {
          "type": "object",
          "properties": {
            "elastic_modulus": { "$ref": "#/$defs/Positive" },
            "poisson_ratio": { "type": "number", "exclusiveMinimum": -1, "exclusiveMaximum": 0.5 },
            "shear_modulus": { "$ref": "#/$defs/Positive" },
            "density": { "type": "number", "minimum": 0 },
            "thermal_expansion": { "type": "number" }
          },
          "required": ["elastic_modulus", "poisson_ratio", "density"],
          "additionalProperties": false
        },
        "strength": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/Positive" }
        },
        "additional": { "type": "object" },
        "provenance": { "$ref": "#/$defs/Provenance" }
      },
      "required": ["number", "general", "properties"],
      "unevaluatedProperties": false
    },
    "SectionProperties": {
      "type": "object",
      "properties": {
        "area": { "$ref": "#/$defs/Positive" },
        "i_y": { "$ref": "#/$defs/Positive" },
        "i_z": { "$ref": "#/$defs/Positive" },
        "i_yz": { "type": "number", "default": 0 },
        "i_t": { "$ref": "#/$defs/Positive" },
        "shear_area_y": { "$ref": "#/$defs/Positive" },
        "shear_area_z": { "$ref": "#/$defs/Positive" },
        "i_w": { "type": "number", "minimum": 0 },
        "shear_centre": { "$ref": "#/$defs/Point2" }
      },
      "required": ["area", "i_y", "i_z", "i_t"],
      "additionalProperties": false
    },
    "Shape": {
      "type": "object",
      "required": ["kind"],
      "oneOf": [
        { "properties": { "kind": { "const": "rectangle" }, "h": true, "b": true }, "required": ["h", "b"], "additionalProperties": false },
        { "properties": { "kind": { "const": "circle" }, "d": true }, "required": ["d"], "additionalProperties": false },
        { "properties": { "kind": { "const": "circular_hollow" }, "d": true, "t": true }, "required": ["d", "t"], "additionalProperties": false },
        { "properties": { "kind": { "const": "rectangular_hollow" }, "h": true, "b": true, "t": true, "r": true }, "required": ["h", "b", "t"], "additionalProperties": false },
        { "properties": { "kind": { "const": "i_section" }, "h": true, "b": true, "t_w": true, "t_f": true, "r": true }, "required": ["h", "b", "t_w", "t_f"], "additionalProperties": false },
        { "properties": { "kind": { "const": "t_section" }, "h": true, "b": true, "t_w": true, "t_f": true }, "required": ["h", "b", "t_w", "t_f"], "additionalProperties": false },
        { "properties": { "kind": { "const": "channel" }, "h": true, "b": true, "t_w": true, "t_f": true }, "required": ["h", "b", "t_w", "t_f"], "additionalProperties": false },
        { "properties": { "kind": { "const": "angle" }, "h": true, "b": true, "t": true }, "required": ["h", "b", "t"], "additionalProperties": false }
      ],
      "properties": {
        "h": { "$ref": "#/$defs/Positive" }, "b": { "$ref": "#/$defs/Positive" }, "d": { "$ref": "#/$defs/Positive" },
        "t": { "$ref": "#/$defs/Positive" }, "t_w": { "$ref": "#/$defs/Positive" }, "t_f": { "$ref": "#/$defs/Positive" },
        "r": { "type": "number", "minimum": 0 }
      }
    },
    "Geometry": {
      "type": "object",
      "properties": {
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "outline": { "$ref": "#/$defs/Polygon" },
              "holes": { "type": "array", "items": { "$ref": "#/$defs/Polygon" } },
              "material": { "$ref": "core.schema.json#/$defs/Uuid" }
            },
            "required": ["outline"],
            "additionalProperties": false
          }
        }
      },
      "required": ["parts"],
      "additionalProperties": false
    },
    "Section": {
      "allOf": [
        { "$ref": "core.schema.json#/$defs/ObjectBase" },
        {
          "oneOf": [
            { "properties": { "definition": { "const": "explicit" } }, "required": ["properties"] },
            { "properties": { "definition": { "const": "parametric" } }, "required": ["shape"] },
            { "properties": { "definition": { "const": "library" } }, "required": ["properties", "provenance"] },
            { "properties": { "definition": { "const": "geometry" } }, "required": ["geometry"] }
          ]
        }
      ],
      "properties": {
        "id": true, "type": { "const": "Section" }, "number": true, "name": true, "extensions": true,
        "definition": { "enum": ["explicit", "parametric", "library", "geometry"] },
        "properties": { "$ref": "#/$defs/SectionProperties" },
        "shape": { "$ref": "#/$defs/Shape" },
        "geometry": { "$ref": "#/$defs/Geometry" },
        "provenance": { "$ref": "#/$defs/Provenance" },
        "design_metadata": { "type": "object" }
      },
      "required": ["number", "definition"],
      "unevaluatedProperties": false
    }
  }
}
